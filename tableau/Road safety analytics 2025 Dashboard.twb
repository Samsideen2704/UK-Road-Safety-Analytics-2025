    <worksheet name='Serious and Fatal Collision Rate by Weather and Road Type (30+ Collisions)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='uk_road_safety_2025' name='federated.1hv1nak0h324s110gzgnr1ob5b1k' />
          </datasources>
          <datasource-dependencies datasource='federated.1hv1nak0h324s110gzgnr1ob5b1k'>
            <column caption='Serious or Fatal Flag' datatype='integer' name='[Calculation_1263951033520134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [collision_severity_label] = &quot;Fatal&quot;&#13;&#10;OR [collision_severity_label] = &quot;Serious&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Weather Road Collision Count' datatype='integer' name='[Calculation_1263951036452871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [road_type_label], [Calculation_1756255562272769] :&#13;&#10;    COUNTD([collision_index])&#13;&#10;}' />
            </column>
            <column caption='Weather Condition Alias' datatype='string' name='[Calculation_1756255562272769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [weather_conditions_label]&#13;&#10;WHEN &quot;Fine, without high winds&quot; THEN &quot;Fine&quot;&#13;&#10;WHEN &quot;Raining, without high winds&quot; THEN &quot;Rain&quot;&#13;&#10;WHEN &quot;Raining, with high winds&quot; THEN &quot;Rain + wind&quot;&#13;&#10;WHEN &quot;Fine, with high winds&quot; THEN &quot;Fine + wind&quot;&#13;&#10;WHEN &quot;Snowing, without high winds&quot; THEN &quot;Snow&quot;&#13;&#10;WHEN &quot;Snowing, with high winds&quot; THEN &quot;Snow + wind&quot;&#13;&#10;WHEN &quot;Fog or mist&quot; THEN &quot;Fog&quot;&#13;&#10;WHEN &quot;Other&quot; THEN &quot;Other&quot;&#13;&#10;WHEN &quot;Unknown&quot; THEN &quot;Unknown&quot;&#13;&#10;ELSE [weather_conditions_label]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Fine + wind&quot;' value='Fine/wind' />
                <alias key='&quot;Rain + wind&quot;' value='Rain/wind' />
                <alias key='&quot;Snow + wind&quot;' value='Snow/wind' />
              </aliases>
            </column>
            <column-instance column='[Calculation_1263951033520134]' derivation='Avg' name='[avg:Calculation_1263951033520134:qk]' pivot='key' type='quantitative' />
            <column caption='Collision Index' datatype='string' name='[collision_index]' role='dimension' type='nominal' />
            <column caption='Collision Severity Label' datatype='string' name='[collision_severity_label]' role='dimension' type='nominal' />
            <column-instance column='[collision_index]' derivation='CountD' name='[ctd:collision_index:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1263951036452871]' derivation='Min' name='[min:Calculation_1263951036452871:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1756255562272769]' derivation='None' name='[none:Calculation_1756255562272769:nk]' pivot='key' type='nominal' />
            <column-instance column='[road_type_label]' derivation='None' name='[none:road_type_label:nk]' pivot='key' type='nominal' />
            <column caption='Road Type Label' datatype='string' name='[road_type_label]' role='dimension' type='nominal' />
            <column caption='Weather Conditions Label' datatype='string' name='[weather_conditions_label]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1hv1nak0h324s110gzgnr1ob5b1k].[min:Calculation_1263951036452871:qk]' included-values='in-range'>
            <min>30</min>
          </filter>
          <slices>
            <column>[federated.1hv1nak0h324s110gzgnr1ob5b1k].[min:Calculation_1263951036452871:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' field='[federated.1hv1nak0h324s110gzgnr1ob5b1k].[none:road_type_label:nk]' value='54' />
            <format attr='width' field='[federated.1hv1nak0h324s110gzgnr1ob5b1k].[none:Calculation_1756255562272769:nk]' value='115' />
            <format attr='text-format' field='[federated.1hv1nak0h324s110gzgnr1ob5b1k].[avg:Calculation_1263951033520134:qk]' value='p0.00%' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.1hv1nak0h324s110gzgnr1ob5b1k].[none:road_type_label:nk]' value='168' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-weight' value='bold' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='font-size' value='8' />
            <format attr='font-weight' value='normal' />
          </style-rule>
          <style-rule element='title'>
            <format attr='font-size' value='8' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
