              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [collision_severity_label] = &quot;Fatal&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([collision_index])' />
