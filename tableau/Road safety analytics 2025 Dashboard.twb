      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([collision_index]) / TOTAL(COUNTD([collision_index]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Casualty Age Group' datatype='string' name='[Calculation_1263951024812032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([age_of_casualty_clean]) THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 18 THEN &quot;Under 18&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 25 THEN &quot;18–24&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 35 THEN &quot;25–34&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 45 THEN &quot;35–44&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 55 THEN &quot;45–54&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 65 THEN &quot;55–64&quot;&#13;&#10;ELSEIF [age_of_casualty_clean] &lt; 75 THEN &quot;65–74&quot;&#13;&#10;ELSE &quot;75+&quot;&#13;&#10;END' />
      </column>
      <column caption='Serious or Fatal Flag' datatype='integer' name='[Calculation_1263951033520134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [collision_severity_label] = &quot;Fatal&quot;&#13;&#10;OR [collision_severity_label] = &quot;Serious&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Weather Road Collision Count' datatype='integer' name='[Calculation_1263951036452871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [road_type_label], [Calculation_1756255562272769] :&#13;&#10;    COUNTD([collision_index])&#13;&#10;}' />
      </column>
      <column caption='Fatal Collision Rate (%)' datatype='real' default-format='*0.00%' name='[Calculation_1267245675528192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [collision_severity_label] = &quot;Fatal&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([collision_index])' />
      </column>
      <column caption='Weather Condition Alias' datatype='string' name='[Calculation_1756255562272769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [weather_conditions_label]&#13;&#10;WHEN &quot;Fine, without high winds&quot; THEN &quot;Fine&quot;&#13;&#10;WHEN &quot;Raining, without high winds&quot; THEN &quot;Rain&quot;&#13;&#10;WHEN &quot;Raining, with high winds&quot; THEN &quot;Rain + wind&quot;&#13;&#10;WHEN &quot;Fine, with high winds&quot; THEN &quot;Fine + wind&quot;&#13;&#10;WHEN &quot;Snowing, without high winds&quot; THEN &quot;Snow&quot;&#13;&#10;WHEN &quot;Snowing, with high winds&quot; THEN &quot;Snow + wind&quot;&#13;&#10;WHEN &quot;Fog or mist&quot; THEN &quot;Fog&quot;&#13;&#10;WHEN &quot;Other&quot; THEN &quot;Other&quot;&#13;&#10;WHEN &quot;Unknown&quot; THEN &quot;Unknown&quot;&#13;&#10;ELSE [weather_conditions_label]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Fine + wind&quot;' value='Fine/wind' />
          <alias key='&quot;Rain + wind&quot;' value='Rain/wind' />
          <alias key='&quot;Snow + wind&quot;' value='Snow/wind' />
        </aliases>
      </column>
      <column caption='Casualty Severity %' datatype='real' default-format='p0.00%' name='[Calculation_1756255636324365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([casualty_reference])&#13;&#10;/&#13;&#10;MIN({ FIXED [casualty_class_label] : COUNT([casualty_reference]) })' />
      </column>
      <column caption='casualties' datatype='table' name='[__tableau_internal_object_id__].[casualties_10FD99DF9B3F4EB7B62141FBC06BA6F3]' role='measure' type='quantitative' />
